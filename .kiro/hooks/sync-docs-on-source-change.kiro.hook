{
  "enabled": true,
  "name": "Sync Docs on Source Change",
  "description": "Watches Python source files and config files for changes, then asks the agent to update README.md, AGENT_CAPABILITIES.md, DEPLOYMENT_GUIDE.md, and deployment/deploy_agentcore.md to reflect any relevant documentation changes.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.py",
      "requirements.txt",
      ".bedrock_agentcore.yaml"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file was just edited. Review the changes and update README.md, AGENT_CAPABILITIES.md, DEPLOYMENT_GUIDE.md, and deployment/deploy_agentcore.md to reflect any relevant documentation changes such as new features, updated APIs, changed configuration, or modified behavior. Only update sections that are actually affected by the change. Do not rewrite unrelated sections."
  },
  "workspaceFolderName": "autonomous-support-desk",
  "shortName": "sync-docs-on-source-change"
}